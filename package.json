{
  "name": "jobber-mcp",
  "version": "1.1.0",
  "description": "Read-only MCP server connecting AI assistants (Claude, ChatGPT, Gemini, Copilot) to Jobber - jobs, invoices, quotes, schedule and clients via Jobber's official GraphQL API.",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "jobber-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx scripts/auth.ts",
    "introspect": "tsx scripts/introspect.ts",
    "smoke": "tsx scripts/smoke.ts",
    "sync:zcode": "node scripts/sync-zcode.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "test:wiring": "tsx scripts/wiring-test.ts"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jobber",
    "field-services",
    "field-service-management",
    "ai-assistant",
    "graphql",
    "claude",
    "chatgpt"
  ],
  "author": "Ajay Sharma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildminimal/jobber-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/buildminimal/jobber-mcp/issues"
  },
  "homepage": "https://github.com/buildminimal/jobber-mcp#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "fflate": "^0.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
