# 1. Create a developer account + app at https://developer.getjobber.com
#    (read-only scopes: Clients, Jobs, Quotes, Scheduled Items, Invoices;
#     leave Callback URL blank - localhost is allowed automatically)
# 2. Copy this file to .env and fill in your app credentials

JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=

# Paste an access token here after running `npm run auth`
JOBBER_ACCESS_TOKEN=

# Optional: enables silent refresh when the access token expires
JOBBER_REFRESH_TOKEN=

# Optional: scopes to request during `npm run auth` (space-separated).
# Leave unset to request your app's configured defaults.
# JOBBER_SCOPES=

# Defaults - rarely changed
# JOBBER_API_ORIGIN=https://api.getjobber.com
# JOBBER_API_VERSION=2026-05-12   # X-JOBBER-GRAPHQL-VERSION header value (current as of Sept 2026)
# JOBBER_API_URL=            # override full GraphQL endpoint if it differs
# JOBBER_CALLBACK_PORT=7331
# Show visit times in your local timezone (IANA name)
# JOBBER_TIMEZONE=Asia/Kolkata
# JOBBER_PAGE_SIZE=25
